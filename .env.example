# Copy this file to .env.local and fill in the values.
# Setup steps are in scripts/google-sheet-webhook.gs

# Public site URL used for Open Graph absolute links (optional).
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Apps Script "Web app" URL that appends RSVPs to your Google Sheet.
# Leave empty to keep RSVPs only in data/rsvps.json (local development).
GOOGLE_SHEET_WEBHOOK_URL=

# Must match SECRET_TOKEN in scripts/google-sheet-webhook.gs
GOOGLE_SHEET_TOKEN=
